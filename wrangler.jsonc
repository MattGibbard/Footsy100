{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "footsy100",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "footsy100",
      // No database_id: `wrangler deploy` creates the database on first deploy.
      "migrations_dir": "migrations"
    }
  ],
  // Sync fixtures/players and settle finished matches every 15 minutes
  "observability": { "enabled": true },
  // Required by `wrangler preview`, which Cloudflare runs for pull request builds.
  // Previews get no bindings by default, so preview URLs show the front end only.
  "previews": {},
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    // Resend's shared test sender only delivers to your own Resend account email.
    // Verify a domain in Resend and change this to send to everyone.
    "EMAIL_FROM": "Footsy100 <onboarding@resend.dev>",
    "DEV_MODE": "false"
  }
  // Secrets (set with `wrangler secret put`): RESEND_API_KEY, ADMIN_TOKEN
}
