{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "footsy100",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "footsy100",
      // No database_id: `wrangler deploy` creates the database on first deploy.
      "migrations_dir": "migrations"
    }
  ],
  // Sync fixtures/players and settle finished matches every 15 minutes
  "observability": { "enabled": true },
  // Required by `wrangler preview`, which Cloudflare runs for pull request builds.
  // Previews get no bindings by default, so preview URLs show the front end only.
  "previews": {},
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "DEV_MODE": "false"
  },
  // Keep variables set in the dashboard (like EMAIL_FROM) when Git builds redeploy.
  "keep_vars": true
  // Set in the dashboard: EMAIL_FROM (variable), RESEND_API_KEY and ADMIN_TOKEN (secrets).
  // Without EMAIL_FROM, mail goes from Resend's test sender, which only delivers to your own Resend account email.
}
