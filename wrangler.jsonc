{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "footsy100",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "footsy100",
      // Replace with the id printed by `wrangler d1 create footsy100`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Sync fixtures/players and settle finished matches every 15 minutes
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APP_URL": "http://localhost:8787",
    "EMAIL_FROM": "Footsy100 <login@example.com>",
    "DEV_MODE": "false"
  }
  // Secrets (set with `wrangler secret put`): RESEND_API_KEY, ADMIN_TOKEN
}
